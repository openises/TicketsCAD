<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS does not read .htaccess at all, so tests/.htaccess protects nothing on
  a Windows/IIS install. This file is the IIS equivalent: deny every request
  that maps into tests/.

  tests/ holds this project's own regression suite — nothing here is part of
  the served application, and several files insert throwaway/synthetic rows
  against a real database when run. None of it should ever be reachable over
  HTTP; the suite is run from the command line only (tools/test_all.php).

  Same shape, same reasoning as sql/web.config and tools/web.config — read
  that file's header for the full history of why Request Filtering is the
  ONE mechanism used (not <authorization>, not hiddenSegments). Denied
  requests are HTTP 404, substatus 404.7. <directoryBrowse enabled="false" />
  is the independent second stop against a directory listing.

  Reported and diagnosed by Ron Jones (@rjonesbsink).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
