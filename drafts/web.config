<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS does not read .htaccess at all, so drafts/.htaccess protects nothing on
  a Windows/IIS install. This file is the IIS equivalent: deny every request
  that maps into drafts/.

  drafts/ holds unfinished planning notes for this project's own development
  process — not part of the served application, and not meant for a visitor.

  Same shape, same reasoning as sql/web.config and tools/web.config — read
  that file's header for the full history of why Request Filtering is the
  ONE mechanism used (not <authorization>, not hiddenSegments). Denied
  requests are HTTP 404, substatus 404.7. <directoryBrowse enabled="false" />
  is the independent second stop against a directory listing.

  Reported and diagnosed by Ron Jones (@rjonesbsink).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
