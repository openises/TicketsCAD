#!/usr/bin/env bash
#
# tools/git-hooks/pre-commit — local QA gate (Eric 2026-07-07).
#
# Runs on every `git commit`:
#   1. php -l on every staged .php file          (syntax)
#   2. tools/schema_audit.php                    (SQL ↔ real database schema)
#   3. tools/api_contract_audit.php              (JS reads ↔ API emitted keys)
#   3b. tools/legacy_level_audit.php             (API gate ↔ the page's RBAC gate)
#   3c. tools/timezone_audit.php                 (stored clock ↔ the clock queried)
#   3d. tools/ui_consistency_audit.php           (new UI ↔ the product's conventions)
#   3e. tools/rbac_permission_audit.php          (rbac_can() code ↔ real permissions row)
#   3f. tools/dead_control_audit.php             (a control/column ↔ anything that reads it)
#   3g. tools/rbac_exclusion_leak_audit.php      (admin-only exclusion list ↔ real role grants)
#   4. tools/gen_schema_manifest.php --check     (manifest ↔ what the code writes)
#   5. tools/generate-sbom.php --check/--verify  (SBOM ↔ dependencies + signature)
#
# This list must stay in step with .github/workflows/qa.yml. A CI gate with no
# local mirror is a gate you meet by email, minutes after pushing, instead of in
# the second before committing — see §5 for what that cost us once already.
#
# Install once per clone:  bash tools/install-git-hooks.sh
# Bypass in an emergency:  git commit --no-verify   (CI still catches it)
#
# The two audits compare against baselines (tools/schema_audit_baseline.txt,
# tools/api_contract_baseline.txt) — they only fail on NEW findings.
# Gates with an environmental prerequisite warn and pass rather than blocking an
# unrelated commit: §2 and §4 need a reachable database (config.php), and §5's
# signature check needs the OpenSSL extension. CI has all three, so nothing is
# lost — the finding simply arrives there instead.

set -u

# Resolve a PHP binary: PATH first, then Eric's XAMPP install.
PHP="$(command -v php || true)"
if [ -z "$PHP" ] && [ -x "/c/xampp/8.2.4/php/php.exe" ]; then
    PHP="/c/xampp/8.2.4/php/php.exe"
fi
if [ -z "$PHP" ]; then
    echo "pre-commit: no php binary found (PATH or /c/xampp/8.2.4) — skipping QA gate" >&2
    exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"
FAILED=0

# ── 1. Syntax-lint staged PHP files ────────────────────────────────
STAGED_PHP="$(git diff --cached --name-only --diff-filter=ACM | grep '\.php$' || true)"
if [ -n "$STAGED_PHP" ]; then
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        if ! "$PHP" -l "$f" > /dev/null 2>&1; then
            echo "✗ syntax error: $f"
            "$PHP" -l "$f" 2>&1 | head -3
            FAILED=1
        fi
    done <<< "$STAGED_PHP"
fi

# ── 2. Schema audit (needs DB; warn-and-pass if unreachable) ───────
if [ -f tools/schema_audit.php ]; then
    OUT="$("$PHP" tools/schema_audit.php 2>&1)"
    CODE=$?
    if echo "$OUT" | grep -qi "connection failed\|Access denied\|Unknown database"; then
        echo "⚠ schema audit skipped (database unreachable) — CI will run it"
    elif [ $CODE -ne 0 ]; then
        echo "✗ schema audit found NEW SQL↔schema mismatches:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 3. API ↔ JS contract audit (static, always runs) ───────────────
if [ -f tools/api_contract_audit.php ]; then
    OUT="$("$PHP" tools/api_contract_audit.php 2>&1)"
    if [ $? -ne 0 ]; then
        echo "✗ API contract audit found NEW JS-reads-what-nothing-emits keys:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 3b. Page/API authorisation-split audit (static, always runs) ───
# An api/ endpoint that gates on the legacy user.level while its page
# gates on RBAC = a screen the user can open but not use.
if [ -f tools/legacy_level_audit.php ]; then
    OUT="$("$PHP" tools/legacy_level_audit.php 2>&1)"
    if [ $? -ne 0 ]; then
        echo "✗ authorisation-split audit found an api/ endpoint gating on user.level alone:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 3c. Clock-consistency audit (static, always runs) ──────────────
# A query that measures a locally-stamped DATETIME against UTC_TIMESTAMP()
# is invisible on a UTC server and silently wrong on every other one.
if [ -f tools/timezone_audit.php ]; then
    OUT="$("$PHP" tools/timezone_audit.php 2>&1)"
    if [ $? -ne 0 ]; then
        echo "✗ clock audit found a timestamp compared against the wrong clock:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 3d. UI-consistency audit (static, always runs) ─────────────────
# New interface work drifting from the conventions the rest of the
# product follows: hotkeys as loose text instead of keycap buttons in
# the header, a dismiss control with no re-open path, hardcoded colours
# that ignore the dark theme, per-user state in a newly invented store.
if [ -f tools/ui_consistency_audit.php ]; then
    OUT="$("$PHP" tools/ui_consistency_audit.php 2>&1)"
    if [ $? -ne 0 ]; then
        echo "✗ UI-consistency audit found NEW interface drift:"
        echo "$OUT" | tail -20
        echo "  Conventions: php tools/ui_consistency_audit.php --rules"
        FAILED=1
    fi
fi

# ── 3e. RBAC permission-code audit (needs DB; warn-and-pass if unreachable) ──
# A rbac_can('some.code')/rbac_require_screen('some.code') referencing a
# permission with no row in the permissions table can never be granted to
# any role — found app-wide 2026-08-15 (an external-API bug report plus a
# wider pass), including api/external/v1/incidents.php's read gate being
# reachable by Super Admin tokens only.
if [ -f tools/rbac_permission_audit.php ]; then
    OUT="$("$PHP" tools/rbac_permission_audit.php 2>&1)"
    CODE=$?
    if echo "$OUT" | grep -qi "connection failed\|Access denied\|Unknown database"; then
        echo "⚠ RBAC permission-code audit skipped (database unreachable) — CI will run it"
    elif [ $CODE -ne 0 ]; then
        echo "✗ RBAC permission-code audit found a code with no permissions-table row:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 3f. Dead-control audit (needs DB for the column half; warn-and-pass if
#      unreachable) ──────────────────────────────────────────────────────
# GH #91: a `data-key="foo"` control that saves and persists with no
# get_variable('foo') anywhere (Chat Bridge, Severity Levels labels before
# the same-night fix), or a database column with a confirmed write path
# whose value is read nowhere. "The cost isn't the dead code itself, it's
# that it reads as live" — a checkbox that persists looks exactly like a
# working switch.
if [ -f tools/dead_control_audit.php ]; then
    OUT="$("$PHP" tools/dead_control_audit.php 2>&1)"
    CODE=$?
    if echo "$OUT" | grep -qi "connection failed\|Access denied\|Unknown database"; then
        echo "⚠ dead-control audit's column check skipped (database unreachable) — CI will run it"
    elif [ $CODE -ne 0 ]; then
        echo "✗ dead-control audit found a NEW dead setting/column:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 3g. RBAC exclusion-list privilege-leak audit (needs DB; warn-and-pass
#      if unreachable) ────────────────────────────────────────────────────
# sql/rbac.sql / sql/run_00_rbac.php grant a role "everything except" a
# literal NOT-IN list of admin-only codes. That shape has leaked an
# excluded permission down to Org Admin/Dispatcher four times (direct
# grant predating the exclusion, a canonical-alias re-grant, and a
# separate migration re-granting it outright) — each caught by a human
# noticing, one at a time. This audit derives the exclusion lists
# directly from the two seed files (generic over any role, not a hand-
# maintained code list) and checks the live database, a cross-file drift
# check between the two files, and a high-precision scan for a NEW
# migration literally granting an excluded code.
if [ -f tools/rbac_exclusion_leak_audit.php ]; then
    OUT="$("$PHP" tools/rbac_exclusion_leak_audit.php 2>&1)"
    CODE=$?
    if echo "$OUT" | grep -qi "connection failed\|Access denied\|Unknown database"; then
        echo "⚠ RBAC exclusion-leak audit skipped (database unreachable) — CI will run it"
    elif [ $CODE -ne 0 ]; then
        echo "✗ RBAC exclusion-leak audit found an admin-only permission reachable by a lower role:"
        echo "$OUT" | tail -20
        FAILED=1
    fi
fi

# ── 4. Schema manifest freshness (needs DB; warn-and-pass if unreachable) ──
# Phase 125: sql/schema_manifest.json is what an INSTALL checks itself against.
# If it goes stale, every user's self-check silently stops covering new columns.
if [ -f tools/gen_schema_manifest.php ]; then
    OUT="$("$PHP" tools/gen_schema_manifest.php --check 2>&1)"
    CODE=$?
    if echo "$OUT" | grep -qi "connection failed\|Access denied\|Unknown database"; then
        echo "⚠ schema manifest check skipped (database unreachable) — CI will run it"
    elif [ $CODE -ne 0 ]; then
        echo "✗ sql/schema_manifest.json is stale — run: php tools/gen_schema_manifest.php"
        echo "$OUT" | tail -5
        FAILED=1
    fi
fi

# ── 5. SBOM freshness + signature (static, always runs) ────────────
# Phase 127: every release ships an SBOM describing the code in it, and CI
# enforces that. This section exists because CI enforced it and nothing local
# did: on 2026-07-29 dependencies moved, the committed SBOM did not, and the
# build went red on a command that costs about a second to run here. The same
# gate then caught a newly vendored component that would otherwise have shipped
# unrecorded — it was doing its job; nobody was reading it until the email.
#
# --check regenerates and compares, so it catches both a moved dependency and a
# hand-edited document. --verify proves the detached signature still matches the
# bytes on disk, so an SBOM edited without re-signing cannot pass either.
#
# --validate (CycloneDX schema conformance) is NOT run unconditionally: it costs
# ~7s against ~1s for the other two, and the only breakage it catches that they
# miss is a generator that emits a non-conforming document. That has exactly one
# cause, so it is gated on that cause below.
if [ -f tools/generate-sbom.php ]; then
    OUT="$("$PHP" tools/generate-sbom.php --check 2>&1)"
    CODE=$?
    if [ $CODE -ne 0 ]; then
        echo "✗ the committed SBOM does not match the current dependencies or VERSION:"
        echo "$OUT" | tail -10
        echo "  Run: php tools/generate-sbom.php   (then review the diff and stage it)"
        FAILED=1
    fi

    OUT="$("$PHP" tools/generate-sbom.php --verify 2>&1)"
    CODE=$?
    if echo "$OUT" | grep -qi "OpenSSL extension is required"; then
        echo "⚠ SBOM signature check skipped (no OpenSSL extension) — CI will run it"
    elif [ $CODE -ne 0 ]; then
        echo "✗ the SBOM signature does not verify against SBOM.cdx.json:"
        echo "$OUT" | tail -10
        FAILED=1
    fi

    # Only the generator itself, or the vendored CycloneDX schemas it validates
    # against, can make the document non-conforming without also making it stale.
    if git diff --cached --name-only --diff-filter=ACM \
         | grep -qE '^tools/(generate-sbom\.php|schema/)'; then
        OUT="$("$PHP" tools/generate-sbom.php --validate 2>&1)"
        CODE=$?
        if [ $CODE -ne 0 ]; then
            echo "✗ SBOM.cdx.json does not conform to the CycloneDX 1.6 schema:"
            echo "$OUT" | tail -10
            FAILED=1
        fi
    fi
fi

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "Commit blocked by the QA gate. Fix the findings above, or for a"
    echo "verified false positive add the key to the relevant baseline file"
    echo "with a comment in the commit message."
    exit 1
fi
exit 0
