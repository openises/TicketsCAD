<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS does not read .htaccess at all, so services/.htaccess protects nothing
  on a Windows/IIS install. This file is the IIS equivalent: deny every
  request that maps into services/, WITH ONE DELIBERATE EXCEPTION.

  services/ holds the bridge scripts for external radio/messaging
  integrations (APRS, DVSwitch/DMR, Meshtastic, MeshCore, the audio matrix),
  install scripts, systemd unit files, and .env.example templates. Some of
  it (services/dvswitch/*.py in particular) is source code Eric does not want
  publicly downloadable in bulk — the Apache rule (.htaccess, root of this
  repo) denies this entire directory by the same policy.

  THE EXCEPTION: the Mesh Console (Settings -> Mesh) hands an operator a
  `curl <this-server>/services/meshtastic/bridge_v2.py` command to install
  the Meshtastic bridge on their own radio host, and MeshCore has the same
  pattern. Those two subdirectories' .py files must stay reachable, or the
  documented install path breaks. See services/meshtastic/web.config and
  services/meshcore/web.config, which override this file's deny for exactly
  that shape of request within their own subtree, via ordinary IIS
  configuration inheritance (the nearer web.config to a request wins),
  mirroring the equivalent allow-list-first ordering already used in
  .htaccess and docs/nginx/ticketscad-hardening.conf.

  Same base mechanism as sql/web.config and tools/web.config; read that
  file's header for the full history of why Request Filtering is used (not
  <authorization>, not hiddenSegments). Denied requests are HTTP 404,
  substatus 404.7. <directoryBrowse enabled="false" /> is the independent
  second stop against a directory listing.

  Reported and diagnosed by Ron Jones (@rjonesbsink).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
