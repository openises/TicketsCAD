<?xml version="1.0" encoding="UTF-8"?>
<!--
  Overrides the blanket deny in services/web.config (one directory up), FOR
  THIS SUBTREE ONLY: the Mesh Console (Settings -> Mesh) hands an operator a
  `curl <this-server>/services/meshtastic/bridge_v2.py` command to install
  the Meshtastic bridge on their own radio host, so this directory's .py
  files specifically must stay downloadable. Mirrors the equivalent
  allow-list-first line in .htaccess and docs/nginx/ticketscad-hardening.conf
  (`RewriteRule (^|/)services/(meshtastic|meshcore)/[A-Za-z0-9_.-]+\.py$ -
  [L]`, evaluated before the blanket services/ deny).

  Standard IIS configuration inheritance: the web.config nearest a request
  wins. <clear /> resets the file-extension collection this directory
  inherited (which permits nothing) before re-adding exactly one extension,
  so nothing beyond .py becomes reachable here that services/web.config would
  otherwise deny; directory listing stays off, and every extension other
  than .py still 404s.

  Do NOT widen this beyond a single fileExtension entry, and do NOT remove
  <directoryBrowse enabled="false" />; both would reopen more than the one
  documented install command needs.

  Reported and diagnosed by Ron Jones (@rjonesbsink).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <fileExtensions allowUnlisted="false">
          <clear />
          <add fileExtension=".py" allowed="true" />
        </fileExtensions>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
