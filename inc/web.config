<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS does not read .htaccess at all, so inc/.htaccess protects nothing on a
  Windows/IIS install. This file is the IIS equivalent: deny every request
  that maps into inc/.

  inc/ holds shared PHP includes — db.php (database credentials), the
  encryption helpers, every writer function the API layer calls. None of it
  is meant to be requested directly; it is only ever require_once'd by
  api/*.php and the page roots.

  ── ONE MECHANISM: REQUEST FILTERING, NOT <authorization>, NOT hiddenSegments

  This is the SAME four-line shape as sql/web.config and tools/web.config —
  read that file's header for the full history (three ways an earlier
  <authorization>-based version returned 500.19 on stock IIS instead of
  denying, and why hiddenSegments is rejected as a mechanism: it matches a
  path segment ANYWHERE, not just the first, which is what took out
  assets/vendor/ site-wide the one time this project tried it). Do not
  deviate from the shape below for this file specifically — the whole point
  of "one mechanism everywhere" is that a reader who has verified it once
  does not have to re-verify it in every directory.

  allowUnlisted="false" with nothing allow-listed denies every request whose
  URL carries a file name extension (db.php itself, any .php here) AND every
  extension-less URL (GET /inc/, GET /inc/db.php with the extension stripped
  by some other rewrite). Denied requests are HTTP 404, substatus 404.7.
  <directoryBrowse enabled="false" /> is the independent second stop against
  a directory listing.

  Reported and diagnosed by Ron Jones (@rjonesbsink).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering allowDoubleEscaping="false">
        <fileExtensions allowUnlisted="false" />
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false" />
  </system.webServer>
</configuration>
