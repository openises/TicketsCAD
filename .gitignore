# NewUI v4 / TicketsCAD — repo .gitignore

# ──────────────────────────────────────────────────────────────────────
#  Per-install secrets and runtime data
# ──────────────────────────────────────────────────────────────────────

# config.php carries DB credentials for the local install.
# Use config.example.php as the committed template and copy it on install.
/config.php

# Encryption keys are per-install; never commit
/keys/
/../keys/
*.pem
!proxy/zello-proxy.pid.example
*.key
!*.example.key

# SBOM signing key (Phase 127). The PRIVATE key is held by the maintainer
# OUTSIDE this repository (see docs/SECURITY-POLICY.md §5.3 for its location)
# and must never be committed. These patterns are defence in depth: even a
# stray copy dropped into the tree stays untracked.
*.key.pem
ticketscad-sbom-signing*
# The PUBLIC key is deliberately published — publishing it is what lets anyone
# verify the SBOM signature without contacting us. It must escape "*.pem".
!SBOM-signing-key.pub.pem

# Python build/cache artifacts (services/aprs, services/meshtastic, etc.)
__pycache__/
*.pyc

# SonarQube scanner working directory — internal state, no source value.
/.scannerwork/

# ──────────────────────────────────────────────────────────────────────
#  Runtime / per-deployment artifacts
# ──────────────────────────────────────────────────────────────────────

# User-uploaded files (per-folder .gitignore already excludes the contents,
# but be defensive in case those stub files are removed)
/uploads/*
!/uploads/.gitignore
!/uploads/.htaccess

/cache/*
!/cache/.gitignore

# Per-deploy backups + audit dumps
/backups/

# PID files
/proxy/*.pid
*.pid

# Logs
*.log
/services/*/logs/

# ──────────────────────────────────────────────────────────────────────
#  Vendored dependencies — installable via composer
# ──────────────────────────────────────────────────────────────────────

# vendor/ is recreated by `composer install`; composer.lock IS committed
/vendor/
/composer.phar

# ──────────────────────────────────────────────────────────────────────
#  IDE / OS noise
# ──────────────────────────────────────────────────────────────────────

.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# ──────────────────────────────────────────────────────────────────────
#  Test temp data
# ──────────────────────────────────────────────────────────────────────

/tests/tmp/
/tools/data/
*.sql.gz

# DMR/AMBE STT measurement harness corpus — real captured radio audio
# (.wav) and its transcripts (Whisper output + a human's hand-labeled
# ground truth in manifest.json). Never commit real radio traffic audio
# or its transcripts. See docs/DMR-STT-MEASUREMENT.md and
# tools/dmr_stt_corpus_sample.php.
/tools/dmr-stt-corpus/

# ──────────────────────────────────────────────────────────────────────
#  Project-internal scratch / one-off scripts
#  (uncomment lines as we consolidate tooling)
# ──────────────────────────────────────────────────────────────────────

/tools/data/

# your deployment-specific seed scripts left from the test deploy — they
# contain real personnel emails and should not be in the public repo.
/tools/a-seed-script.php
/tools/enrich_from_contacts_csv.php
/tools/commit_confirmed_callsigns.php
/tools/fcc_find_missing.php
/tools/debug_search_unmatched.php
/tools/debug_radioid_pages.php

# Docker Compose local environment (holds DB passwords) — never commit
.env

# Upgrade orchestrator artifacts — DB dumps + run logs (may contain live data)
tools/upgrade/backups/
tools/upgrade/upgrade-*.log

# Local Claude Code state, including the agent worktrees kept at
# .claude/worktrees/<name>/ — each an entire second copy of this repository.
# Never part of the product tree.
#
# Untracked was not enough. Unignored, one `git add -A` commits a duplicate of
# the whole project, and tools that WALK the tree kept re-importing these files:
# `specs/` is excluded from the SBOM anchored at the repository root, so it never
# matched .claude/worktrees/x/specs/…, and a Phase 36 planning mock-up walked
# back in as a sortablejs component — `generate-sbom.php --check` then failed on
# any machine that happened to have a worktree open (fixed in 269d79b by adding
# .claude/ to that tool's exclusion list; this entry closes the git side).
#
# Anchorless on purpose: a nested .claude/ inside a worktree is ignored too.
.claude/

# Probe test files planted (and swept) by tests/test_runner_end_to_end.php to
# drive the real runner against a file that fatals. They exist for a few
# hundred milliseconds. If a crashed run ever leaks one it will break the next
# full suite run — which is the point, it is a test file that fatals — but it
# must not be committable by a stray `git add -A`.
tests/test_zzprobe_*.php
